{
  "name": "react-tree-layout",
  "version": "0.1.0",
  "description": "VS Code-style tree-based panel layout for React",
  "license": "ISC",
  "author": "dannysir",
  "keywords": [
    "react",
    "layout",
    "panel",
    "split",
    "resize",
    "drag-drop",
    "tree"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dannysir/react-tree-layout.git"
  },
  "bugs": {
    "url": "https://github.com/dannysir/react-tree-layout/issues"
  },
  "homepage": "https://github.com/dannysir/react-tree-layout#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
